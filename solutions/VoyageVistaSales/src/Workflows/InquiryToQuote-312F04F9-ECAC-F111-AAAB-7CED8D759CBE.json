            },
            "parameters": {
              "entityName": "voy_inquirytoquotes",
              "$select": "businessprocessflowinstanceid, _processid_value,traversedpath",
              "$filter": "_bpf_voy_travelinquiryid_value eq @{outputs('Get_related_Travel_Inquiry')?['body/voy_travelinquiryid']}",
              "$top": 1
            },
            "authentication": {
              "type": "Raw",
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
            }
